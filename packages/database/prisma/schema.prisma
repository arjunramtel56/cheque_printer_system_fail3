// =============================================================================
// Prisma schema for the Reactify Cheque Printer System
// Full multi-tenant schema with RBAC, subscriptions, CMS, and audit logging
// =============================================================================

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================================
// Users & Authentication
// =============================================================================

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique
  passwordHash      String
  emailVerified     DateTime?
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?
  status            UserStatus @default(active)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  profile           UserProfile?
  memberships       OrganizationMember[]
  sessions          Session[]
  refreshTokens     RefreshToken[]
  loginAttempts     LoginAttempt[]
  securityEvents    SecurityEvent[]
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  chequeJobs        ChequeJob[]
  printHistory      PrintHistory[]
  savedPayees       SavedPayee[]
  subscriptions     Subscription[]
  notifications     Notification[]
  supportTickets    SupportTicket[]
  auditLogs         AuditLog[]
  adminActions      AdminAction[]
  createdBy         AuditLog[]   @relation("AuditCreatedBy")
  updatedBy         AuditLog[]   @relation("AuditUpdatedBy")

  @@index([email])
  @@index([status])
}

enum UserStatus {
  active
  suspended
  pending_verification
}

model UserProfile {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @unique @db.Uuid
  user        User    @relation(fields: [userId], references: [id])
  firstName   String
  lastName    String
  phone       String?
  avatarUrl   String?
  locale      String  @default("en")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// =============================================================================
// Organizations & Multi-tenancy
// =============================================================================

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  logoUrl     String?
  status      OrganizationStatus @default(active)
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  memberships  OrganizationMember[]
  chequeJobs   ChequeJob[]
  printHistory PrintHistory[]
  subscriptions Subscription[]
  auditLogs    AuditLog[]
  adminActions AdminAction[]
  notifications Notification[]

  @@index([slug])
  @@index([status])
}

enum OrganizationStatus {
  active
  suspended
  deleted
}

model OrganizationMember {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id])
  userId          String @db.Uuid
  user            User   @relation(fields: [userId], references: [id])
  roleId          String @db.Uuid
  role            Role   @relation(fields: [roleId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

// =============================================================================
// RBAC - Roles & Permissions
// =============================================================================

model Role {
  id              String  @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  isSystemRole    Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships     OrganizationMember[]
  permissions     RolePermission[]

  @@unique([name])
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles       RolePermission[]

  @@unique([resource, action])
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @db.Uuid
  role         Role   @relation(fields: [roleId], references: [id])
  permissionId String @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime @default(now())

  @@unique([roleId, permissionId])
}

// =============================================================================
// Sessions & Security
// =============================================================================

model Session {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id])
  tokenHash       String   @unique
  ipAddress       String?
  userAgent       String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model RefreshToken {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id])
  tokenHash   String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model TwoFactorSecret {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  secret      String
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LoginAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @db.Uuid
  user        User?    @relation(fields: [userId], references: [id])
  email       String
  ipAddress   String
  userAgent   String?
  success     Boolean
  failureReason String?
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([ipAddress])
  @@index([createdAt])
}

model SecurityEvent {
  id          String   @id @default(uuid()) @db.Uuid
  eventType   String
  userId      String?  @db.Uuid
  ipAddress   String?
  userAgent   String?
  detail      Json?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
}

model PasswordResetToken {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id])
  tokenHash   String   @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([tokenHash])
}

model EmailVerificationToken {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id])
  tokenHash   String   @unique
  expiresAt   DateTime
  verifiedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([tokenHash])
}

// =============================================================================
// Banks & Templates
// =============================================================================

model Bank {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  code         String?    @unique
  nrbClass     NrbClass
  status       BankStatus @default(active)
  logoUrl      String?
  enabled      Boolean    @default(true)
  supersededBy String?
  verifiedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  branches     BankBranch[]
  templates    ChequeTemplate[]

  @@index([code])
  @@index([status])
}

enum NrbClass {
  A
  B
  C
  D
}

enum BankStatus {
  active
  merged
  defunct
  inactive
}

model BankBranch {
  id          String   @id @default(uuid()) @db.Uuid
  bankId      String   @db.Uuid
  bank        Bank     @relation(fields: [bankId], references: [id])
  name        String
  code        String?
  address     String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([bankId])
}

model ChequeTemplate {
  id                String   @id @default(uuid()) @db.Uuid
  bankId            String   @db.Uuid
  bank              Bank     @relation(fields: [bankId], references: [id])
  name              String
  paperWidth        Float
  paperHeight       Float
  orientation       Orientation
  backgroundImage   String?
  fontFamily        String?
  fontSize          Float?
  fontWeight        String?
  dateFormat        String?
  activeStatus      Boolean  @default(true)
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  fields            TemplateField[]
  versions          TemplateVersion[]
  printerProfiles   PrinterProfile[]
  userPreferences   UserTemplatePreference[]
  chequeJobs        ChequeJob[]

  @@index([bankId])
  @@index([activeStatus])
}

enum Orientation {
  portrait
  landscape
}

model TemplateField {
  id              String   @id @default(uuid()) @db.Uuid
  templateId      String   @db.Uuid
  template        ChequeTemplate @relation(fields: [templateId], references: [id])
  fieldType       String
  fieldName       String
  xPosition       Float
  yPosition       Float
  width           Float
  height          Float
  fontSize        Float?
  fontFamily      String?
  fontWeight      String?
  textAlign       String?
  letterSpacing   Float?
  lineHeight      Float?
  rotation        Float?
  maxLength       Int?
  isRequired      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([templateId])
}

model TemplateVersion {
  id          String   @id @default(uuid()) @db.Uuid
  templateId  String   @db.Uuid
  template    ChequeTemplate @relation(fields: [templateId], references: [id])
  version     Int
  data        Json
  createdAt   DateTime @default(now())

  @@unique([templateId, version])
}

model PrinterProfile {
  id          String   @id @default(uuid()) @db.Uuid
  templateId  String   @db.Uuid
  template    ChequeTemplate @relation(fields: [templateId], references: [id])
  name        String
  settings    Json
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([templateId])
}

model UserTemplatePreference {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  templateId  String   @db.Uuid
  template    ChequeTemplate @relation(fields: [templateId], references: [id])
  settings    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, templateId])
}

// =============================================================================
// Cheque Jobs & Print History
// =============================================================================

model ChequeJob {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @db.Uuid
  user            User        @relation(fields: [userId], references: [id])
  organizationId  String?     @db.Uuid
  organization    Organization? @relation(fields: [organizationId], references: [id])
  templateId      String      @db.Uuid
  template        ChequeTemplate @relation(fields: [templateId], references: [id])
  status          ChequeStatus @default(DRAFT)
  payeeName       String
  amount          Decimal     @db.Decimal(15, 2)
  amountWords     String
  chequeDate      DateTime
  memo            String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  fields          ChequeJobField[]
  printAttempts   PrintAttempt[]

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
}

enum ChequeStatus {
  DRAFT
  PREVIEWED
  TEST_PRINTED
  PRINT_REQUESTED
  PRINTED
  FAILED
  CANCELLED
  REPRINTED
}

model ChequeJobField {
  id          String   @id @default(uuid()) @db.Uuid
  jobId       String   @db.Uuid
  job         ChequeJob @relation(fields: [jobId], references: [id])
  fieldName   String
  value       String
  createdAt   DateTime @default(now())

  @@index([jobId])
}

model PrintHistory {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id])
  organizationId  String?  @db.Uuid
  organization    Organization? @relation(fields: [organizationId], references: [id])
  jobId           String?  @db.Uuid
  templateId      String   @db.Uuid
  payeeName       String
  amount          Decimal  @db.Decimal(15, 2)
  chequeDate      DateTime
  printedAt       DateTime @default(now())
  ipAddress       String?

  @@index([userId])
  @@index([organizationId])
  @@index([printedAt])
}

model PrintAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  jobId       String   @db.Uuid
  job         ChequeJob @relation(fields: [jobId], references: [id])
  status      String
  error       String?
  printerInfo String?
  createdAt   DateTime @default(now())

  @@index([jobId])
}

model SavedPayee {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id])
  name        String
  bankName    String?
  accountNo   String?
  address     String?
  phone       String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// =============================================================================
// Subscriptions & Payments
// =============================================================================

model Plan {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  slug            String   @unique
  description     String?
  priceMonthly    Decimal  @db.Decimal(10, 2)
  priceYearly     Decimal? @db.Decimal(10, 2)
  maxPrints       Int?
  maxUsers        Int?
  features        Json?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions   Subscription[]

  @@index([slug])
  @@index([isActive])
}

model Subscription {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id])
  organizationId  String?  @db.Uuid
  organization    Organization? @relation(fields: [organizationId], references: [id])
  planId          String   @db.Uuid
  plan            Plan     @relation(fields: [planId], references: [id])
  status          SubscriptionStatus @default(active)
  billingCycle    BillingCycle @default(monthly)
  startDate       DateTime
  endDate         DateTime?
  trialEndsAt     DateTime?
  cancelAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  usage           SubscriptionUsage[]
  payments        Payment[]
  invoices        Invoice[]

  @@index([userId])
  @@index([organizationId])
  @@index([status])
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  unpaid
}

enum BillingCycle {
  monthly
  yearly
}

model SubscriptionUsage {
  id              String   @id @default(uuid()) @db.Uuid
  subscriptionId  String   @db.Uuid
  subscription    Subscription @relation(fields: [subscriptionId], references: [id])
  period          String
  printsUsed      Int      @default(0)
  printsLimit     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([subscriptionId, period])
}

model Payment {
  id              String   @id @default(uuid()) @db.Uuid
  subscriptionId  String   @db.Uuid
  subscription    Subscription @relation(fields: [subscriptionId], references: [id])
  amount          Decimal  @db.Decimal(10, 2)
  currency        String   @default("NPR")
  status          PaymentStatus @default(pending)
  paymentMethod   String?
  transactionId   String?
  paidAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invoices        Invoice[]

  @@index([subscriptionId])
  @@index([status])
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

model Invoice {
  id              String   @id @default(uuid()) @db.Uuid
  subscriptionId  String   @db.Uuid
  subscription    Subscription @relation(fields: [subscriptionId], references: [id])
  paymentId       String?  @db.Uuid
  payment         Payment? @relation(fields: [paymentId], references: [id])
  invoiceNumber   String   @unique
  amount          Decimal  @db.Decimal(10, 2)
  currency        String   @default("NPR")
  status          InvoiceStatus @default(draft)
  issuedAt        DateTime?
  dueAt           DateTime?
  paidAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([subscriptionId])
  @@index([invoiceNumber])
}

enum InvoiceStatus {
  draft
  issued
  paid
  overdue
  void
}

model Coupon {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique
  discountPercent Int?
  discountAmount  Decimal? @db.Decimal(10, 2)
  maxUses         Int?
  usedCount       Int      @default(0)
  expiresAt       DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([code])
}

// =============================================================================
// Notifications
// =============================================================================

model Notification {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id])
  organizationId  String?  @db.Uuid
  organization    Organization? @relation(fields: [organizationId], references: [id])
  type            String
  title           String
  message         String
  data            Json?
  readAt          DateTime?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
}

model EmailLog {
  id          String   @id @default(uuid()) @db.Uuid
  to          String
  subject     String
  template    String?
  status      String
  sentAt      DateTime @default(now())
  error       String?

  @@index([to])
  @@index([sentAt])
}

// =============================================================================
// Support
// =============================================================================

model SupportTicket {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id])
  subject         String
  status          TicketStatus @default(open)
  priority        TicketPriority @default(normal)
  category        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  messages        SupportMessage[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum TicketStatus {
  open
  in_progress
  waiting_for_user
  resolved
  closed
}

enum TicketPriority {
  low
  normal
  high
  urgent
}

model SupportMessage {
  id          String   @id @default(uuid()) @db.Uuid
  ticketId    String   @db.Uuid
  ticket      SupportTicket @relation(fields: [ticketId], references: [id])
  senderId    String?  @db.Uuid
  message     String
  isInternal  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([ticketId])
  @@index([createdAt])
}

// =============================================================================
// CMS & Content
// =============================================================================

model Page {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  title       String
  content     Json?
  status      ContentStatus @default(draft)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  sections     PageSection[]

  @@index([slug])
  @@index([status])
}

model PageSection {
  id          String   @id @default(uuid()) @db.Uuid
  pageId      String   @db.Uuid
  page        Page     @relation(fields: [pageId], references: [id])
  title       String
  content     Json?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([pageId])
}

model BlogPost {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  title       String
  excerpt     String?
  content     Json?
  coverImage  String?
  authorId    String?
  status      ContentStatus @default(draft)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
}

enum ContentStatus {
  draft
  published
  archived
}

model Faq {
  id          String   @id @default(uuid()) @db.Uuid
  question    String
  answer      String
  category    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

model Translation {
  id          String   @id @default(uuid()) @db.Uuid
  key         String
  locale      String
  value       String
  namespace   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, locale, namespace])
  @@index([locale])
}

model MediaFile {
  id          String   @id @default(uuid()) @db.Uuid
  filename    String
  originalName String
  mimeType    String
  size        Int
  url         String
  alt         String?
  uploadedBy  String?
  createdAt   DateTime @default(now())

  @@index([mimeType])
}

// =============================================================================
// Audit & Admin
// =============================================================================

model AuditLog {
  id              String   @id @default(uuid()) @db.Uuid
  eventType       String
  actorId         String?  @db.Uuid
  actor           User?    @relation("AuditCreatedBy", fields: [actorId], references: [id])
  organizationId  String?  @db.Uuid
  organization    Organization? @relation(fields: [organizationId], references: [id])
  resourceType    String
  resourceId      String?
  action          String
  oldValue        Json?
  newValue        Json?
  ipAddress       String?
  userAgent       String?
  requestId       String?
  createdAt       DateTime @default(now())

  @@index([actorId])
  @@index([organizationId])
  @@index([resourceType, resourceId])
  @@index([eventType])
  @@index([createdAt])
}

model AdminAction {
  id              String   @id @default(uuid()) @db.Uuid
  adminId         String   @db.Uuid
  admin           User     @relation(fields: [adminId], references: [id])
  organizationId  String?  @db.Uuid
  organization    Organization? @relation(fields: [organizationId], references: [id])
  action          String
  targetType      String
  targetId        String?
  detail          Json?
  ipAddress       String?
  createdAt       DateTime @default(now())

  @@index([adminId])
  @@index([organizationId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}
