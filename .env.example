# Reactify Cheque Printer System — Environment Variables
#
# Copy this file to .env.local before running the server.

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# PostgreSQL connection string for the Prisma database.
# Required by: api routes, prisma/seed.ts, admin persistence
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Next.js environment (set automatically; kept here for documentation)
# NEXTAUTH_URL=http://localhost:3000
