# ═══════════════════════════════════════════════════════════════════════════
# Reactify Cheque Printer System — environment template
#
# Local:  copy to `.env` (or `.env.local`) and fill in real values.
# Vercel: set each variable under Settings → Environment Variables, scoped to
#         the correct environment (Production / Preview / Development).
#
# This file contains ONLY variables the code actually reads.
# Never put real credentials in this file. Full inventory, the numbered
# Vercel list, and the obsolete-variable list live in ENVIRONMENT.md.
# ═══════════════════════════════════════════════════════════════════════════

# ─── 1. Supabase PostgreSQL (Prisma) ───────────────────────────────────────
# RUNTIME connection — Prisma Client uses this on every database request.
# Supabase TRANSACTION pooler (port 6543) is the correct target for Vercel
# serverless. Keep pgbouncer=true and connection_limit=1; never include a
# channel_binding parameter (unsupported by Prisma).
DATABASE_URL=postgresql://postgres.jjbbzwxssjojildxxpow:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1&connect_timeout=15

# MIGRATION/CLI connection — direct (non-pooler) host, used ONLY by Prisma CLI
# (db push, db execute, migrate, studio). Not read at application runtime and
# not required on Vercel. Set it wherever you run Prisma CLI (local dev, CI
# jobs that touch the schema).
DIRECT_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.jjbbzwxssjojildxxpow.supabase.co:5432/postgres?sslmode=require

# ─── 2. Authentication (Auth.js v5) ────────────────────────────────────────
# JWT session signing. Required in every environment; minimum 32 characters.
# Generate: openssl rand -base64 32
# Use a SEPARATE value for Preview and Production, marked Sensitive in Vercel.
AUTH_SECRET=

# One-time admin bootstrap secret for POST /api/admin/bootstrap and
# `npm run db:bootstrap-admin`. Required in Production to create the first
# admin; optional locally (the endpoint returns a clear error if unset).
# Generate: openssl rand -base64 32 — rotate after bootstrap.
# This is NOT an admin password; real admin credentials are never stored in env.
ADMIN_BOOTSTRAP_SECRET=

# ─── 3. Application ────────────────────────────────────────────────────────
# Canonical absolute URL of the app, no trailing slash (no path, no locale).
# Used by src/lib/config.ts for links and canonical/OG tags.
# Falls back to http://localhost:3000 if unset — so set it in Preview and
# Production. NEXT_PUBLIC_* values are inlined at BUILD time: change the value,
# then create a NEW deployment (redeploying the old build does not pick it up).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── 4. Optional feature flags ─────────────────────────────────────────────
# Expose /dev/calibration in production builds (default: off; always on in dev).
#ENABLE_CALIBRATION=true

# Trust X-Forwarded-* headers for rate limiting when self-hosting behind a
# reverse proxy. NOT needed on Vercel — the VERCEL variable is detected
# automatically by src/lib/rate-limit.ts.
#TRUST_PROXY_HEADERS=true

# ─── 5. Reserved — Supabase client integration (NOT read by current code) ──
# The @supabase/ssr / @supabase/supabase-js packages are installed, but no file
# in this repository imports them yet. Do NOT set these in Vercel until a
# Supabase browser/server client actually exists (e.g. src/utils/supabase/*).
# If that integration is added, these become required:
#   NEXT_PUBLIC_SUPABASE_URL   + NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  (public, browser)
#   SUPABASE_URL               + SUPABASE_PUBLISHABLE_KEY              (server)
#   SUPABASE_SECRET_KEY        (server — NEVER NEXT_PUBLIC_*; grants admin access)
#   SUPABASE_JWKS_URL          (only if verifying Supabase-issued JWTs)
#NEXT_PUBLIC_SUPABASE_URL=https://jjbbzwxssjojildxxpow.supabase.co
#NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#SUPABASE_URL=https://jjbbzwxssjojildxxpow.supabase.co
#SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#SUPABASE_SECRET_KEY=sb_secret_...
#SUPABASE_JWKS_URL=https://jjbbzwxssjojildxxpow.supabase.co/auth/v1/.well-known/jwks.json
