# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reactify_cheque
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reactify_cheque

# Redis
REDIS_URL=redis://localhost:6379

# Auth
AUTH_SECRET=your-auth-secret-change-in-production
ENCRYPTION_KEY=your-encryption-key-change-in-production

# Email
EMAIL_API_KEY=your-email-api-key
EMAIL_FROM=noreply@reactify.com

# File Storage (S3/MinIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=reactify-cheque

# Payment
PAYMENT_SECRET=your-payment-secret

# Monitoring
SENTRY_DSN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
