generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
  TRIAL_USER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  PENDING_VERIFICATION
}

enum ChequeStatus {
  DRAFT
  READY
  PRINTED
  CANCELLED
}

enum PaymentStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
}

enum PaymentMethod {
  FONEPAY
  BANK_TRANSFER
  CASH
  OTHER
}

enum Orientation {
  PORTRAIT
  LANDSCAPE
}

// ─── Users & Auth ─────────────────────────────────────────────────────

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  emailVerified DateTime?
  passwordHash  String
  role          UserRole      @default(TRIAL_USER)
  status        AccountStatus @default(PENDING_VERIFICATION)
  isActive      Boolean       @default(true)
  phone         String?
  company       String?
  trialExpires  DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

   subscription   Subscription?
   chequeEntries  ChequeEntry[]
   payees         Payee[]
   printHistories PrintHistory[]
   settings       UserSettings?
   sessions       Session[]
   auditLogs      AuditLog[]
   payments       Payment[]

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([status, isActive])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Plans & Subscriptions ────────────────────────────────────────────

model Plan {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  price       Decimal  @default(0) @db.Decimal(10, 2)
  currency    String   @default("NPR")
  durationDays Int     @default(30)
  chequeLimit Int      @default(50)
  features    Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

   subscriptions Subscription[]
   payments       Payment[]

   @@index([name])
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String    @unique
  planId    String
  startDate DateTime  @default(now())
  endDate   DateTime
  isActive  Boolean   @default(true)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([planId])
}

// ─── Payments ─────────────────────────────────────────────────────────────

model Payment {
  id              String       @id @default(cuid())
  userId          String
  planId          String
  amount          Decimal      @db.Decimal(10, 2)
  currency        String       @default("NPR")
  paymentMethod   PaymentMethod @default(FONEPAY)
  durationMonths  Int          @default(1)
  proofUrl        String?
  reference       String?
  notes           String?
  status          PaymentStatus @default(PENDING_VERIFICATION)
  submittedAt     DateTime     @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([submittedAt])
}

// ─── Banks & Templates ────────────────────────────────────────────────

model Bank {
  id          String            @id @default(cuid())
  name        String
  code        String            @unique
  logoUrl     String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

   templates BankTemplate[]

   UserSettingsDefaultBank UserSettings[] @relation("UserSettingsDefaultBank")

   @@index([code])
}

model BankTemplate {
  id             String   @id @default(cuid())
  bankId         String
  name           String
  chequeWidth    Float    @default(210)
  chequeHeight   Float    @default(90)
  backgroundUrl  String?
  isActive       Boolean  @default(true)
  isDefault      Boolean  @default(false)
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

   bank             Bank              @relation(fields: [bankId], references: [id], onDelete: Cascade)
   fields           TemplateField[]
   chequeEntries    ChequeEntry[]
   UserSettingsDefaultTemplate UserSettings[] @relation("UserSettingsDefaultTemplate")

   @@index([bankId])
   @@unique([bankId, name])
}

model TemplateField {
  id           String  @id @default(cuid())
  templateId   String
  field        String
  x            Float
  y            Float
  width        Float?
  height       Float?
  fontSize     Float   @default(12)
  fontFamily   String  @default("Arial")
  fontWeight   String  @default("normal")
  letterSpacing Float?
  lineHeight   Float?
  align        String  @default("left")
  rotation     Float?
  color        String  @default("#000000")
  format       String?
  template     BankTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@unique([templateId, field])
}

// ─── Cheque Entries ───────────────────────────────────────────────────

model ChequeEntry {
  id              String      @id @default(cuid())
  userId          String
  templateId      String
   accountHolder   String
   payeeName       String?
   chequeNumber    String?
   chequeDate      DateTime
   amountNumber    Decimal     @db.Decimal(12, 2)
  amountWords     String
  status          ChequeStatus @default(DRAFT)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  lastPrintedAt   DateTime?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  template       BankTemplate    @relation(fields: [templateId], references: [id])
  printHistories PrintHistory[]

  @@index([userId])
  @@index([templateId])
  @@index([status])
  @@index([chequeNumber])
  @@unique([userId, chequeNumber], name: "unique_cheque_per_user")
}

// ─── Payees ──────────────────────────────────────────────────────────
model Payee {
  id           String   @id @default(cuid())
  userId       String
  name         String
  address      String?
  phone        String?
  email        String?
  bankAccount  String?
  chequeLimit  Decimal? @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([name])
}

// ─── Print History ────────────────────────────────────────────────────
model PrintHistory {
  id           String   @id @default(cuid())
  userId       String
  chequeId     String
  printedAt    DateTime @default(now())
  printerName  String?
  copies       Int      @default(1)
  notes        String?

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cheque ChequeEntry @relation(fields: [chequeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([chequeId])
  @@index([printedAt])
}

// ─── User Settings ────────────────────────────────────────────────────

model UserSettings {
  id                 String  @id @default(cuid())
  userId             String  @unique
  defaultBankId      String?
  defaultTemplateId  String?
  defaultAccountName String?
  language           String  @default("en")
  dateFormat         String  @default("YYYY-MM-DD")
  currency           String  @default("NPR")
  printerName        String?

   user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  defaultBank     Bank?         @relation("UserSettingsDefaultBank", fields: [defaultBankId], references: [id])
  defaultTemplate BankTemplate? @relation("UserSettingsDefaultTemplate", fields: [defaultTemplateId], references: [id])

  @@index([userId])
}

// ─── System Settings ──────────────────────────────────────────────────

model SystemSettings {
  id             String  @id @default(cuid())
  key            String  @unique
  value          Json
  description    String?
  updatedAt      DateTime @updatedAt

  @@index([key])
}

// ─── Audit Logs ───────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action, createdAt])
  @@index([entity])
  @@index([createdAt])
}
