// =============================================================================
// Prisma schema for the Reactify Cheque Printer System.
//
// STATUS: placeholder — the current repository ships no server-side persistence.
// All bank/template/size data lives in src/data/*.ts and is seeded client-side.
// This schema codifies the SAME domain model (see src/lib/types.ts) so the
// migration to V1.8 (server-side auth + persistence) is a drop-in.
//
// Run `npx prisma generate` after installing prisma to regenerate the client.
// =============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// Banks — Nepal Rastra Bank institutions and their class.
// ---------------------------------------------------------------------------
model Bank {
  id           String     @id @default(uuid: String) @db.Uuid
  name         String
  nrbClass     NrbClass
  code         String?    @unique
  status       BankStatus @default(active)
  enabled      Boolean    @default(true)
  supersededBy String?    // bankId of the institution this bank merged into
  verifiedAt   DateTime?  // ISO date the catalogue entry was last checked
  templates    ChequeTemplate[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum NrbClass {
  A
  B
  C
  D
}

enum BankStatus {
  active
  merged
  defunct
  inactive
}

// ---------------------------------------------------------------------------
// Cheque templates — one per bank, describing physical field positions.
// ---------------------------------------------------------------------------
model ChequeTemplate {
  id        String             @id @default(uuid: String) @db.Uuid
  bankId    String             @db.Uuid
  bank      Bank               @relation(fields: [bankId], references: [id])
  label     String
  sizeId    String
  widthMm   Float
  heightMm  Float
  orientation Orientation
  fields    Json               // serialized Record<string, TemplateField>
  structural Json?             // serialized Record<string, StructuralPosition>
  safeZones Json?              // serialized SafeZone[]
  profiles  Json               // serialized Record<ProfileKey, PrintProfile>
  printX    Float              // default calibration X
  printY    Float              // default calibration Y
  supportedModes Json           // serialized ProfileKey[]
  verificationStatus VerificationStatus @default(unverified)
  verifiedAt   DateTime?
  note         String?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([bankId])
  @@index([sizeId])
}

enum Orientation {
  portrait
  landscape
}

enum VerificationStatus {
  unverified
  browser_verified
  physically_calibrated
}

// ---------------------------------------------------------------------------
// Cheque sizes — the single source of physical millimetre truth.
// ---------------------------------------------------------------------------
model ChequeSize {
  id        String   @id
  label     String
  widthMm   Float
  heightMm  Float
  builtin   Boolean  @default(false)
}

// ---------------------------------------------------------------------------
// Paper sizes — carrier stock (A4 portrait / landscape).
// ---------------------------------------------------------------------------
model PaperSize {
  id          String     @id
  label        String
  widthMm      Float
  heightMm     Float
  orientation   Orientation
}

// ---------------------------------------------------------------------------
// Calibration records — per (template × mode) offsets in mm.
// ---------------------------------------------------------------------------
model Calibration {
  id          String   @id @default(uuid: String) @db.Uuid
  templateId  String   @db.Uuid
  profileKey  String   // ProfileKey enum value
  x           Float
  y           Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([templateId, profileKey])
}

// ---------------------------------------------------------------------------
// Admin sessions — for the future server-side auth gate (V1.8).
// ---------------------------------------------------------------------------
model AdminSession {
  id        String   @id @default(uuid: String) @db.Uuid
  passwordHash String  // scrypt hash, never plaintext
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// ---------------------------------------------------------------------------
// Audit log — records every admin mutation for traceability.
// ---------------------------------------------------------------------------
model AuditLog {
  id          String   @id @default(uuid: String) @db.Uuid
  action      String
  entityType  String
  entityId    String?
  detail      Json?
  createdAt   DateTime @default(now())
}
